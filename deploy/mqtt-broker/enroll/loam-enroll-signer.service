# Loam federation auto-enrollment signer — system service.
# Install to /etc/systemd/system/ via enroll/install-signer.sh; it renders this
# unit from params.env with envsubst. ${VARS} resolved from params.env.
#
# LIVE-HOST SAFETY: dedicated unprivileged ${ENROLL_USER} under a tight sandbox;
# binds only ${ENROLL_PORT} (default 8443) on ${ENROLL_BIND_ADDRESS} (default
# 0.0.0.0 — the port is public; TLS + the shared password + rate limiting are
# the security walls). It may read the org CA (ReadOnlyPaths) and must write
# CA-issued certs' inputs only under its own temp dir (PrivateTmp). The shared
# enrollment password is a separate 0600 file (PrivateTmp covers runtime, and
# ReadOnlyPaths marks the deploy dir it lives next to if needed).
[Unit]
Description=Loam Federation auto-enrollment signer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${ENROLL_USER}
Group=${ENROLL_USER}
ExecStartPre=${PYTHON_BIN} ${ENROLL_DIR}/signer.py --ping
ExecStart=${PYTHON_BIN} ${ENROLL_DIR}/signer.py
Restart=on-failure
RestartSec=5

# --- sandbox (holds on a shared host; mirrors loam-mosquitto.service) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The org CA (read-only) and the enrollment password file must be readable:
ReadOnlyPaths=${PKI_DIR} ${ENROLL_DIR}
# No writable host path; PrivateTmp gives it its own scratch for CSR/cert.

[Install]
WantedBy=multi-user.target
