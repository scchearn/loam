# Loam MQTT broker deployment — parameter manifest (EXAMPLE / template).
#
# Copy to `params.env` (gitignored) and fill the FILL-IN-LATER values on the
# target host. This file is sourced by the deploy scripts:  `set -a; . ./params.env; set +a`
#
# RULES:
#   - Never put a secret/token/private key in this file or in params.env.
#     Secrets are referenced by lookup command or creds-file PATH only.
#   - Host-specific values are marked FILL-IN-LATER; LOCKED values are decided.

# ---- Deploy target (LOCKED: colocate on the live invoice host) -------------
DEPLOY_TARGET=colocate                 # LOCKED — bigboss decided A; dedicated path retired.

# ---- Broker identity -------------------------------------------------------
# NOTE: this tracked template holds NO real host identifiers. Put the real
# (locked) FQDN/IP in the gitignored params.env, never here.
ORG_ID=                                # FILL-IN-LATER — the single {org-id} topic root.
BROKER_FQDN=mqtt.example.org           # FILL-IN-LATER — real (locked) value in params.env.
BROKER_IP=                             # FILL-IN-LATER — broker host IP.
LISTENER_PORT=8883                     # MQTTS. The ONLY port this deployment binds.

# ---- Host paths (defaults are host-independent; confirm on host) -----------
MOSQ_ETC=/etc/mosquitto
MOSQ_PERSIST=/var/lib/mosquitto
MOSQ_USER=mosquitto                    # dedicated unprivileged service user (create if absent).
MOSQ_BIN=/usr/bin/mosquitto            # FILL-IN-LATER — confirm ExecStart path on host.
PKI_DIR=/etc/mosquitto/pki             # org CA + client-cert verification material (cafile).
BACKUP_DIR=/var/backups/loam-mqtt      # broker-owned backups only.

# ---- Server cert (certbot / Let's Encrypt, DNS-01 via Cloudflare) ----------
CERTBOT_LIVE_DIR=/etc/letsencrypt/live/${BROKER_FQDN}
CERTBOT_CLOUDFLARE_INI=/root/.secrets/certbot-cloudflare.ini   # PATH only — confirm host's existing certbot creds path.

# ---- Cloudflare DNS A-record step (T9) -------------------------------------
# Lookup COMMAND only — never the token value. Fetched at runtime.
CF_DNS_TOKEN_LOOKUP='secret-tool lookup service cloudflare field cloudflare-dns-token'
CF_ZONE=example.org

# ---- Credential resolution (T12) — secret-service backend ------------------
# Backend is chosen by OS at runtime (Linux: secret-tool; macOS: security/Keychain).
# See RESOLUTION-CONTRACT.md. The service/label the material is stored under:
SECRET_SERVICE_LABEL=loam-federation

# ---- Auto-enrollment signer (specs/federation-auto-enrollment.md) ----------
# The one HTTPS endpoint machines POST {password, csr} to for their mTLS cert.
# Reuses the host's Let's Encrypt server cert; binds ENROLL_BIND_ADDRESS
# (default 0.0.0.0 — TLS + password + rate limit are the walls on a public
# VPS), rate-limited.
ENROLL_DIR=/etc/loam/enroll             # signer.py + the 0600 shared password file.
ENROLL_USER=loam-enroll                 # dedicated unprivileged service user (create if absent).
ENROLL_PORT=8443                        # HTTPS. Exposed on the public port by default.
ENROLL_RATE_LIMIT=10                    # requests per client per 60s window (brute-force bound).

# ---- Peer roster (T13) -----------------------------------------------------
# Root the connector reads injected PeerRoster from. See ROSTER-CONTRACT.md.
LOAM_FEDERATION_ROSTER_DIR="${HOME}/.agents/loam/federation/rosters"

# ---- Preflight/postflight service-integrity (T11) --------------------------
# Space-separated systemd units + config files to snapshot on the live host.
# Set the REAL units/configs in the gitignored params.env after host recon.
WATCH_UNITS="serviceA serviceB"                 # FILL-IN-LATER — the host's existing units to protect.
WATCH_CONFIGS="/etc/serviceA/serviceA.conf"     # FILL-IN-LATER — confirm real config paths on host.
