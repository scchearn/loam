# Loam MQTT broker deployment — parameter manifest (EXAMPLE / template).
#
# Copy to `params.env` (gitignored) and fill the FILL-IN-LATER values on the
# target host. This file is sourced by the deploy scripts:  `set -a; . ./params.env; set +a`
#
# RULES:
#   - Never put a secret/token/private key in this file or in params.env.
#     Secrets must be supplied by lookup commands or credential-file PATHs,
#     never as literal values.
#   - Host-specific values are marked FILL-IN-LATER; set them for the target host.

# ---- Deploy target -----------------------------------------------------------
DEPLOY_TARGET=colocate                 # Run the broker on this deployment host.

# ---- Broker identity -------------------------------------------------------
# NOTE: this tracked template holds NO real host identifiers. Put the real
# FQDN/IP in the gitignored params.env, never here.
ORG_ID=                                # FILL-IN-LATER — organization segment in loam/v1/<org>/ topics.
BROKER_FQDN=mqtt.example.org           # FILL-IN-LATER — DNS name for the broker host.
BROKER_IP=                             # FILL-IN-LATER — IP address for the broker host.
LISTENER_PORT=8883                     # MQTTS listener port for the broker.

# ---- Host paths (defaults are host-independent; confirm on host) -----------
MOSQ_ETC=/etc/mosquitto
MOSQ_PERSIST=/var/lib/mosquitto
MOSQ_USER=mosquitto                    # dedicated unprivileged service user (create if absent).
MOSQ_BIN=/usr/bin/mosquitto            # FILL-IN-LATER — confirm the executable path on the host.
PKI_DIR=/etc/mosquitto/pki             # org CA + client-cert verification material (cafile).
BACKUP_DIR=/var/backups/loam-mqtt      # broker-owned backups only.

# ---- Server cert (certbot / Let's Encrypt, DNS-01 via Cloudflare) ----------
CERTBOT_LIVE_DIR=/etc/letsencrypt/live/${BROKER_FQDN}
CERTBOT_CLOUDFLARE_INI=/root/.secrets/certbot-cloudflare.ini   # PATH only — confirm the host's existing certbot credential path.

# ---- Cloudflare DNS A-record configuration ----------------------------------
# Secret lookup command only — never put the token value here; fetch it at runtime.
CF_DNS_TOKEN_LOOKUP='secret-tool lookup service cloudflare field cloudflare-dns-token'
CF_ZONE=example.org

# ---- Credential resolution — secret-service backend --------------------------
# The operating system selects the backend at runtime (Linux: secret-tool;
# macOS: security/Keychain). See ../../docs/federation/RESOLUTION-CONTRACT.md
# for the files and trust settings read by the runtime. The service/label under
# which the material is stored:
SECRET_SERVICE_LABEL=loam-federation

# ---- Enrollment signer -------------------------------------------------------
# The HTTPS signer accepts {password, csr} and returns a client certificate.
# It reuses the host's Let's Encrypt server certificate, copies it into
# ${ENROLL_DIR}/tls/ because the certbot live directory is root-only, and
# refreshes the copy through the certbot renewal hook. It also copies the org
# CA into ca/ while keeping issuance state in PKI_DIR. See
# ../../docs/federation/BROKER-SETUP.md#6-install-the-enrollment-signer for
# installation and rotation instructions.
ENROLL_DIR=/etc/loam/enroll             # signer.py + ca/ + tls/ + password.
ENROLL_USER=loam-enroll                 # dedicated unprivileged service user (create if absent).
ENROLL_PORT=8443                        # HTTPS. Exposed on the public port by default.
ENROLL_RATE_LIMIT=10                    # requests per client per 60s window (brute-force bound).

# ---- Peer roster -------------------------------------------------------------
# Directory where the connector reads per-project peer allow-lists. See
# ../../docs/federation/ROSTER-CONTRACT.md for the file format and path.
LOAM_FEDERATION_ROSTER_DIR="${HOME}/.agents/loam/federation/rosters"

# ---- Preflight and postflight service-integrity checks -----------------------
# Space-separated systemd units + config files to snapshot on the target host.
# Set the actual units/configs in the gitignored params.env after checking the
# target host.
WATCH_UNITS="serviceA serviceB"                 # FILL-IN-LATER — existing units to protect.
WATCH_CONFIGS="/etc/serviceA/serviceA.conf"     # FILL-IN-LATER — existing config paths to protect.
