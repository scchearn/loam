#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

HOME_ROOT="$TMP/home"
WORKSPACE="$TMP/workspace"
mkdir -p "$HOME_ROOT" "$WORKSPACE"
export HOME="$HOME_ROOT"
export USERPROFILE="$HOME_ROOT"

PACKED_NAME="$(npm pack --silent --pack-destination "$TMP")"
tar -xzf "$TMP/$PACKED_NAME" -C "$TMP"
PACKED_ROOT="$TMP/package"

EXPECTED_VERSION="$(node -p "require('$PACKED_ROOT/package.json').version")"
[[ "$(node "$PACKED_ROOT/bin/loam.mjs" --version)" == "$EXPECTED_VERSION" ]] || {
  printf 'FAIL: packed version command mismatch\n' >&2
  exit 1
}

node "$PACKED_ROOT/bin/loam.mjs" --help >/dev/null
DRY_RUN_OUTPUT="$(cd "$WORKSPACE" && node "$PACKED_ROOT/bin/loam.mjs" setup --dry-run --yes 2>&1)"
printf '%s\n' "$DRY_RUN_OUTPUT" | grep -Eiq 'dry.?run' || {
  printf 'FAIL: packed dry-run did not report preview mode\n' >&2
  exit 1
}
[[ ! -e "$HOME_ROOT/.agents/loam" ]] || {
  printf 'FAIL: packed dry-run created a global Loam root\n' >&2
  exit 1
}

# The shared Node session integration is retired: the packed tree must not ship
# the context renderer or the session hook, and the integration must not serve a
# `hook` command at any spelling.
for RETIRED in integration/context.mjs hooks/session-start.mjs hooks/hooks.json plugins/loam-adapter/hooks/session-start.mjs; do
  [[ ! -e "$PACKED_ROOT/$RETIRED" ]] || {
    printf 'FAIL: packed tree still ships the retired %s\n' "$RETIRED" >&2
    exit 1
  }
done
if grep -Fq 'run --' "$PACKED_ROOT/integration/loam.mjs"; then
  printf 'FAIL: packed integration retains the public run proxy\n' >&2
  exit 1
fi
(cd "$WORKSPACE" && node "$PACKED_ROOT/integration/loam.mjs" hook --harness claude --workspace "$WORKSPACE" >/dev/null 2>&1) && {
  printf 'FAIL: packed integration still serves the retired hook command\n' >&2
  exit 1
}
# Positive control for the line above: the same entry point still answers
# `status`, so the refusal is a retirement and not a broken module.
(cd "$WORKSPACE" && node "$PACKED_ROOT/integration/loam.mjs" status >/dev/null 2>&1) || true
STATUS_ERR="$(cd "$WORKSPACE" && node "$PACKED_ROOT/integration/loam.mjs" status 2>&1 >/dev/null || true)"
[[ -z "$STATUS_ERR" ]] || {
  printf 'FAIL: packed integration cannot serve status: %s\n' "$STATUS_ERR" >&2
  exit 1
}

# The OpenCode plugin carries the runtime slot setup fills at stage time — no
# session-time resolution of the version-qualified runtime path.
grep -Fq '__LOAM_RUNTIME_PATH__' "$PACKED_ROOT/adapters/opencode.mjs" || {
  printf 'FAIL: packed OpenCode adapter has no staged runtime slot\n' >&2
  exit 1
}

printf 'OK: packaged setup contract passed\n'
