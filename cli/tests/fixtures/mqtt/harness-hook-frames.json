    { "id": "opencode", "key": null },
    { "id": "claude", "key": "additionalContext" },
    { "id": "codex", "key": null },
    { "id": "cursor", "key": "additional_context" }
  ],
  "frames": [
    {
      "name": "claude-session-start",
      "text": "{\"session_id\":\"s-1\",\"hook_event_name\":\"SessionStart\",\"source\":\"startup\",\"cwd\":\"WORKSPACE\"}"
    },
    {
      "name": "cursor-session-start",
      "text": "{\"conversation_id\":\"c-1\",\"workspaceRoot\":\"WORKSPACE\"}"
    },
    {
      "name": "opencode-transform",
      "text": "{\"workspace\":{\"root\":\"WORKSPACE\"}}"
    },
    {
      "name": "codex-plugin-event",
      "text": "{\"session\":{\"cwd\":\"WORKSPACE\"}}"
    },
    {
      "name": "no-root-reported",
      "text": "{}"
    },
    {
      "name": "absent-frame",
      "text": ""
    }
  ],
  "malformed": [
    { "name": "truncated-json", "text": "{not json", "code": "frame_not_json" },
    { "name": "array-frame", "text": "[1,2]", "code": "frame_not_an_object" },
